parameters:
    level: 5
    phpVersion: 80400
    # App modules only — the rest of modules/ is stock Trongate, maintained upstream
    paths:
        - config
        - modules/cli
        - modules/customer
        - modules/deployments
        - modules/encryption
        - modules/github_auth
        - modules/log
        - modules/impersonation
        - modules/mcp
        - modules/metrics
        - modules/news
        - modules/overview
        - modules/platform
        - modules/projects
        - modules/related_records
        - modules/secrets
        - modules/services
        - modules/templates
        - modules/webhooks
    excludePaths:
        analyse:
            # Views are templates with variables injected via extract()
            - modules/*/views/*
            - modules/*/*/views/*
            # tg-admin pages generated by Flo's module builder, where the table's module name is taken
            - modules/*/admin/*
    scanDirectories:
        - engine
        - modules
    bootstrapFiles:
        - phpstan-bootstrap.php
    # redirect() always exits
    earlyTerminatingFunctionCalls:
        - redirect
    # Defined from the environment at runtime
    dynamicConstantNames:
        - ENV
        - BASE_URL
        - APP_KEY
        - MAIL_KEY
        - GITHUB_APP_SLUG
        - GITHUB_APP_CLIENT_ID
        - GITHUB_APP_CLIENT_SECRET
        - GITHUB_APP_PRIVATE_KEY
        - GITHUB_APP_WEBHOOK_SECRET
        - PLATFORM_SOURCE_REPOSITORY
        - PLATFORM_SOURCE_BRANCH
        - PLATFORM_IMAGES_REGISTRY
    ignoreErrors:
        # Task scripts are included by Runtime and receive $payload, $task, $runtime
        -
            message: '#^Variable \$(payload|task|runtime) might not be defined\.$#'
            path: modules/platform/tasks/*
