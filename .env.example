# Trongate Cloud environment.
# Local dev runs on Herd + MariaDB. In the cluster these values come from the
# trongate-cloud ConfigMap and the SOPS-encrypted trongate-cloud-env and
# trongate-cloud-mcp Secrets
# (see deploy/k8s/README.md). Generate a filled-in copy with scripts/setup-env.sh.

# --- App -------------------------------------------------------------------

# Encrypts stored secrets (provider tokens) and derives tenant database
# passwords. The app and the worker MUST share it. Rotating it makes stored
# secrets unreadable and rotates every tenant DB password on its next deploy.
# Generate with: php -r "echo base64_encode(sodium_crypto_secretbox_keygen());"
APP_KEY=

# Bearer secret for the admin MCP endpoint (POST /mcp). Empty disables it.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
MCP_SECRET=

# The trongate.cloud GitHub App (docs/github-app.md): customers sign in and
# pick repositories through it, builds read them with its installation tokens
# and its webhook (BASE_URL/webhooks/github) delivers pushes. The private key
# may be one line with literal \n sequences.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

BASE_URL=https://trongate.cloud/
ENV=prod

# Platform database (local dev on Herd uses the defaults in config/database.php)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tcloud
DB_USER=tcloud
DB_PASSWORD=

# --- Platform (config/platform.php; the worker reads the same names) --------

# Apps get "{slug}.PLATFORM_APPS_DOMAIN" (wildcard DNS + certificate needed).
# A registrable domain of its own, not a subdomain of trongate.cloud, so an app
# can never set cookies the control panel receives.
PLATFORM_APPS_DOMAIN=trongate.dev
# Registry + path prefix built images are pushed to: {PLATFORM_REGISTRY}/p{project_id}:{sha}-{deployment}
PLATFORM_REGISTRY=registry.trongate.cloud/tc
# Gateway API Gateway that tenant HTTPRoutes attach to
PLATFORM_GATEWAY_NAME=platform
PLATFORM_GATEWAY_NAMESPACE=traefik
# Custom domains: their Gateways' class, the ClusterIssuer for their certificates,
# and the load balancer addresses (comma-separated) their A/AAAA records must
# point at before they are routed. Empty addresses: only a CNAME passes.
PLATFORM_GATEWAY_CLASS=traefik
PLATFORM_DOMAIN_ISSUER=letsencrypt-tenants
PLATFORM_INGRESS_IPV4=
PLATFORM_INGRESS_IPV6=
# Sablier API as reached from Traefik (scale-to-zero middleware)
SABLIER_URL=http://sablier.sablier.svc.cluster.local:10000
# BuildKit daemon the worker builds with. Leave empty in the cluster: the worker
# then starts a throwaway daemon Pod per build. Local dev: e.g. tcp://127.0.0.1:1234
BUILDKIT_HOST=
# RWX StorageClass (JuiceFS) for persistent paths
FILES_STORAGE_CLASS=tenant-files

# Kubernetes API for the worker. Leave empty in the cluster: the worker then
# uses its in-cluster service account. Set these only to run the worker
# outside the cluster (e.g. against a dev cluster).
KUBE_API_URL=
KUBE_TOKEN=
KUBE_CA_FILE=

# --- Worker builds ---------------------------------------------------------

# Base image customer apps are built FROM (docker/app-base); the default is
# what build_platform and bin/push-images.sh push
# PLATFORM_APP_BASE_IMAGE=registry.trongate.cloud/platform/app-base:php8.4
# Directory containing config.json with push credentials for PLATFORM_REGISTRY
# DOCKER_CONFIG=/home/worker/.docker
