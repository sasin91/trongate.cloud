# Task worker: polls the tasks table and runs modules/platform/tasks/*.php.
# Builds customer apps with Railpack + buildctl against a remote BuildKit (BUILDKIT_HOST).
FROM php:8.4-cli-bookworm

ARG RAILPACK_VERSION=0.40.1
ARG BUILDKIT_VERSION=0.33.1
ARG TARGETARCH=amd64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsodium-dev ca-certificates curl \
    && docker-php-ext-install pcntl sodium mysqli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# railpack (checksum-verified) and buildctl, pinned
RUN case "${TARGETARCH}" in \
        amd64) rp_arch=x86_64 ;; \
        arm64) rp_arch=arm64 ;; \
        *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rp_file="railpack-v${RAILPACK_VERSION}-${rp_arch}-unknown-linux-musl.tar.gz" \
    && rp_base="https://github.com/railwayapp/railpack/releases/download/v${RAILPACK_VERSION}" \
    && cd /tmp \
    && curl -fsSLO "${rp_base}/${rp_file}" \
    && curl -fsSL "${rp_base}/checksums.txt" | grep " ${rp_file}\$" | sha256sum -c - \
    && tar -xzf "${rp_file}" -C /usr/local/bin railpack \
    && curl -fsSL "https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-${TARGETARCH}.tar.gz" \
        | tar -xz -C /usr/local bin/buildctl \
    && rm -f /tmp/*.tar.gz \
    && railpack --version && buildctl --version

# The frontend must match the railpack CLI version that wrote the plan
ENV RAILPACK_VERSION=${RAILPACK_VERSION} \
    RAILPACK_FRONTEND=ghcr.io/railwayapp/railpack-frontend:v${RAILPACK_VERSION} \
    DOCKER_CONFIG=/home/worker/.docker

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin worker

WORKDIR /app

# Only the framework-free code the worker loads (see modules/platform/worker/Runtime.php)
COPY config/platform.php config/platform.php
COPY modules/encryption modules/encryption
COPY modules/services/clients modules/services/clients
COPY modules/platform modules/platform

USER 1000

# Grace period for in-flight tasks: must match Runtime::STALE_THRESHOLD_SECONDS
STOPSIGNAL SIGTERM

CMD ["php", "modules/platform/worker/server.php"]
