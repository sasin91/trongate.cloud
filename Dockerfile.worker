# Task worker: polls the tasks table and runs modules/platform/tasks/*.php.
# Builds customer apps and the platform with buildctl against a per-build BuildKit daemon.
# diff3 (diffutils) merges framework files for Trongate upgrades (Trongate_upgrade::merge3).
# The same image runs the mail inbox (modules/platform/mail/server.php, deploy/k8s/platform/mail.yaml).

# Composer packages the worker uses (nikic/php-parser for Config_editor)
FROM composer:2.8 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --ignore-platform-reqs --optimize-autoloader

FROM php:8.4-cli-bookworm

ARG BUILDKIT_VERSION=0.33.1
# Set by BuildKit from --platform (linux/amd64 -> amd64, linux/arm64 -> arm64);
# no default, so a build without it fails below instead of shipping the wrong arch
ARG TARGETARCH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsodium-dev ca-certificates curl diffutils \
    && docker-php-ext-install pcntl sodium pdo_mysql \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# buildctl, pinned
RUN case "${TARGETARCH}" in \
        amd64|arm64) ;; \
        *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-${TARGETARCH}.tar.gz" \
        | tar -xz -C /usr/local bin/buildctl \
    && buildctl --version

ENV DOCKER_CONFIG=/home/worker/.docker

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin worker

WORKDIR /app

# Only the code the worker loads (see modules/platform/worker/Runtime.php); the
# framework's Db class (and its Trongate base) is used without the router
COPY --from=vendor /app/vendor vendor
COPY config/platform.php config/platform.php
COPY engine/Trongate.php engine/Trongate.php
COPY modules/db modules/db
COPY modules/encryption modules/encryption
COPY modules/services/clients modules/services/clients
COPY modules/platform modules/platform
COPY db/migrations db/migrations
# Built by a deploy when the registry lacks PLATFORM_APP_BASE_IMAGE (Platform_task::ensure_app_base)
COPY docker/app-base docker/app-base

USER 1000

# Grace period for in-flight tasks: must match Runtime::STALE_THRESHOLD_SECONDS
STOPSIGNAL SIGTERM

CMD ["php", "modules/platform/worker/server.php"]
