# Platform app (trongate.cloud) on FrankenPHP, classic mode.
# Trongate defines constants per request, so FrankenPHP worker mode is not an option.
{
	admin off
	auto_https off
	persist_config off

	frankenphp

	# Requests arrive from Traefik (pods in 10.42.0.0/16), which replaces any
	# X-Forwarded-For a visitor sends with the visitor's address. Trust the
	# header from there only, rightmost untrusted entry first.
	servers {
		trusted_proxies static 10.42.0.0/16
		trusted_proxies_strict
	}
}

:{$PORT:8080} {
	root * /app/public

	encode zstd br gzip

	# .htaccess is ignored by Caddy; set its headers here
	header {
		Content-Security-Policy "frame-ancestors 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Serves existing files, otherwise falls back to index.php with REQUEST_URI intact.
	# TLS ends at Traefik, which redirects plain http to https, so every visitor
	# is on https: tell PHP so, or current_url() and anything else reading
	# $_SERVER['HTTPS'] builds http:// links and form actions.
	php_server {
		env HTTPS on
		# The visitor's address, not Traefik's: sign-in throttling and
		# anything else reading REMOTE_ADDR would otherwise see one IP for all.
		env REMOTE_ADDR {client_ip}
	}
}
