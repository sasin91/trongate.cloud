# Customer apps on FrankenPHP, classic mode (Trongate defines constants per
# request, so worker mode is not an option). A repository's own Caddyfile
# replaces this one (deploy.php).
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
		output stderr
		level INFO
	}

	frankenphp
}

:{$PORT:8080} {
	root * /app/public

	encode zstd br gzip

	file_server {
		hide .git
		hide .env*
	}

	# .htaccess is ignored by Caddy; apps can only be framed by themselves
	header Content-Security-Policy "frame-ancestors 'self'"

	# Serves existing files, otherwise falls back to index.php with REQUEST_URI intact.
	# TLS ends at Traefik, which redirects plain http to https, so every visitor
	# is on https: tell PHP so, or current_url() and anything else reading
	# $_SERVER['HTTPS'] builds http:// links and form actions.
	php_server {
		env HTTPS on
	}
}
