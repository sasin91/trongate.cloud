{
    "name": "sasin91/trongate.cloud",
    "description": "Managed deployment platform for Trongate applications",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude .git .",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "test": [
            "php tests/Config_editor_test.php",
            "php tests/Deploy_steps_test.php",
            "php tests/App_wizard_draft_test.php",
            "php tests/Trongate_upgrade_test.php",
            "php tests/News_test.php",
            "php tests/App_traffic_test.php",
            "php tests/Mail_capture_test.php",
            "php tests/App_state_test.php",
            "php tests/Admin_pages_test.php",
            "php tests/Cluster_overview_test.php",
            "php tests/App_password_test.php",
            "php tests/Schema_diagram_test.php",
            "php tests/Schema_diff_test.php",
            "php tests/App_database_tsv_test.php",
            "php tests/App_env_suggestions_test.php",
            "php tests/Domain_dns_test.php",
            "php tests/Setup_sql_plan_test.php",
            "php tests/Sql_import_test.php",
            "php tests/Sql_checker_test.php",
            "php tests/Github_link_test.php",
            "php tests/Build_commands_test.php",
            "php tests/Object_storage_test.php",
            "php tests/App_backup_test.php",
            "php tests/Impersonation_test.php",
            "php tests/Log_test.php",
            "php tests/Cli_test.php"
        ],
        "qa": [
            "@lint",
            "@cs",
            "@analyse",
            "@test"
        ]
    }
}
