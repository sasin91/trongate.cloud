{
    "name": "sasin91/trongate.cloud",
    "description": "Managed deployment platform for Trongate applications",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude .git .",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@lint",
            "@cs",
            "@analyse"
        ]
    }
}
