FROM php:8.4-cli

RUN apt-get update && apt-get install -y \
    libsodium-dev \
    openssh-client \
    curl \
    && apt-get clean \
    && docker-php-ext-install pcntl sodium mysqli

# SSH directory for platform key (written from env vars at runtime)
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

# Copy and configure entrypoint script
COPY docker/server-tasks-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php", "modules/servers/tasks/runtime/server.php"]
