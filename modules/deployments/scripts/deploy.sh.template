#!/bin/bash
set -euo pipefail

# Generated by Trongate Cloud
# Deployment ID: ${DEPLOYMENT_ID}
# Project: ${PROJECT_LABEL}
# Date: ${TIMESTAMP}

PROJECT_ID="${PROJECT_ID}"
SERVER_IP="${SERVER_IP}"
DOMAIN="${DOMAIN}"
SSH_KEY_PATH="/tmp/deploy_key_${DEPLOYMENT_ID}"

# Write SSH key (decrypted from DB)
cat > ${SSH_KEY_PATH} <<'SSHKEY'
${PRIVATE_KEY}
SSHKEY
chmod 600 ${SSH_KEY_PATH}

SSH_OPTS="-i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

# Generate .env file
cat > /tmp/${PROJECT_ID}.env <<'ENVFILE'
${ENVIRONMENT_VARIABLES}
ENVFILE

# Generate docker-compose.yml
cat > /tmp/${PROJECT_ID}-compose.yml <<'COMPOSEFILE'
${DOCKER_COMPOSE_CONTENT}
COMPOSEFILE

# Generate prometheus.yml
cat > /tmp/${PROJECT_ID}-prometheus.yml <<'PROMETHEUSFILE'
${PROMETHEUS_CONFIG}
PROMETHEUSFILE

# Sync application code
echo "Syncing application code..."
rsync -avz --delete \
  -e "ssh ${SSH_OPTS}" \
  ${SOURCE_PATH}/ \
  root@${SERVER_IP}:/var/www/${PROJECT_ID}/app/

# Sync configuration files
echo "Deploying configuration..."
rsync -avz \
  -e "ssh ${SSH_OPTS}" \
  /tmp/${PROJECT_ID}-compose.yml \
  root@${SERVER_IP}:/var/www/${PROJECT_ID}/docker-compose.yml

rsync -avz \
  -e "ssh ${SSH_OPTS}" \
  /tmp/${PROJECT_ID}.env \
  root@${SERVER_IP}:/var/www/${PROJECT_ID}/.env

rsync -avz \
  -e "ssh ${SSH_OPTS}" \
  /tmp/${PROJECT_ID}-prometheus.yml \
  root@${SERVER_IP}:/var/www/${PROJECT_ID}/prometheus.yml

# Deploy containers
echo "Starting containers..."
ssh ${SSH_OPTS} root@${SERVER_IP} << 'REMOTECMD'
cd /var/www/${PROJECT_ID}
docker compose pull
docker compose up -d
docker compose ps
REMOTECMD

echo "Deployment complete!"
echo "Application available at: https://${DOMAIN}"

# Cleanup
rm -f ${SSH_KEY_PATH}
rm -f /tmp/${PROJECT_ID}.env
rm -f /tmp/${PROJECT_ID}-compose.yml
rm -f /tmp/${PROJECT_ID}-prometheus.yml
