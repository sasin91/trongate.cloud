global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - ${PROJECT_ID}_alertmanager:9093

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'traefik'
    static_configs:
      - targets: ['${PROJECT_ID}_traefik:8080']

  - job_name: 'node-exporter'
    static_configs:
      - targets: ['${PROJECT_ID}_node-exporter:9100']

  - job_name: 'app'
    static_configs:
      - targets: ['${PROJECT_ID}_app:80']
    metrics_path: '/metrics'
