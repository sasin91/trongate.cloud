FROM alpine:3.19

# Install OpenSSH for ssh-keygen
RUN apk add --no-cache openssh-keygen bash

# Create directory for certificates
RUN mkdir -p /certs

# Copy certificate renewal script
COPY docker/cert-renewal.sh /usr/local/bin/cert-renewal.sh
RUN chmod +x /usr/local/bin/cert-renewal.sh

WORKDIR /certs

# Run renewal loop
CMD ["/usr/local/bin/cert-renewal.sh"]
